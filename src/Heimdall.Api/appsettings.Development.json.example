{
  "//": "Copy to appsettings.Development.json (gitignored). There is NO shipped default password: on first launch Heimdall shows a 'create admin account' screen (stored in the DB) and auto-generates a JWT signing secret under your local app data. Set Heimdall:Jwt:Secret here only if you want to pin it explicitly.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Heimdall": "Host=localhost;Port=5432;Database=heimdall;Username=heimdall;Password=heimdall_dev_pw"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3100", "http://localhost:3000", "http://localhost:3001", "http://localhost:3002" ]
  },
  "Heimdall": {
    "EnrollmentKey": "dev-local-enrollment-key-change-me",
    "Jwt": {
      "LifetimeHours": 8
    },
    "//SshDiscovery": "Optional read-only SSH discovery: Heimdall periodically re-probes each server and refreshes its inventory (OS / CPU / RAM / disk / ports). 'Name' must match a server card; 'KeyPath' points to a LOCAL private key file (e.g. ~/.ssh/id_ed25519) — the key material is never stored. This section lives only in your gitignored appsettings.Development.json, never in the repo.",
    "SshDiscovery": {
      "IntervalMinutes": 30,
      "Servers": []
    }
  }
}
