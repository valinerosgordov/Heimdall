<Window x:Class="Heimdall.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Heimdall" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen" Background="#0A0A0F">
    <Grid>
        <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />
        <StackPanel x:Name="Loading" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="[//] HEIMDALL" Foreground="#FF1E2D" FontFamily="Consolas"
                       FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock x:Name="Status" Text="Starting…" Foreground="#9CA3B4" FontFamily="Consolas"
                       FontSize="13" Margin="0,14,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
